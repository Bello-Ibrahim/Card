# ReconX Streamlit UI
FROM python:3.11-slim-bookworm AS builder

ENV PIP_NO_CACHE_DIR=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential gcc \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN python -m pip install --upgrade pip setuptools wheel \
 && pip wheel --wheel-dir /wheels ".[ui]"

# --------------------------------------------------------------------------- #
FROM python:3.11-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="ReconX UI" \
      org.opencontainers.image.description="Streamlit interface for the ReconX reconciliation platform" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    RECONX_SERVICE=reconx-ui \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_FILE_WATCHER_TYPE=none \
    STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true \
    STREAMLIT_SERVER_ENABLE_CORS=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1001 reconx \
 && useradd --uid 1001 --gid reconx --create-home --shell /usr/sbin/nologin reconx

COPY --from=builder /wheels /wheels
RUN pip install --no-index --find-links=/wheels reconx[ui] && rm -rf /wheels

USER reconx
WORKDIR /home/reconx
EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

CMD ["sh", "-c", "streamlit run $(python -c 'import reconx.ui.streamlit_app as m; print(m.__file__)') \
     --server.port=8501 --server.address=0.0.0.0"]
