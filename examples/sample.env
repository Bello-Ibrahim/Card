# ReconX configuration.
#
#   cp .env.example .env      and edit for local development.
#
# NEVER commit a real .env. In Kubernetes these come from a ConfigMap
# (non-secret) and a Secret (everything under "secrets" below).

# --------------------------------------------------------------- platform
RECONX_ENVIRONMENT=local          # local | dev | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | console
RECONX_STAGING_DIR=/var/reconx/staging

# --------------------------------------------------------------- MongoDB
# Configuration store: definitions, versions, connections, runs, locks, users.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=reconx
MONGODB_TLS=false

# ----------------------------------------------------------------- Kafka
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=reconciliation
KAFKA_SECURITY_PROTOCOL=PLAINTEXT   # PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
#KAFKA_SASL_MECHANISM=SCRAM-SHA-512
#KAFKA_SASL_USERNAME=reconx
#KAFKA_SASL_PASSWORD=               # secret
#KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/corp-ca.pem

# ----------------------------------------- metrics / results database (JDBC)
RESULT_JDBC_URL=jdbc:postgresql://localhost:5432/reconx_results
RESULT_JDBC_DRIVER=org.postgresql.Driver
RESULT_JDBC_USER=reconx
RESULT_JDBC_PASSWORD=reconx          # secret
RESULT_SCHEMA_NAME=public
# Create missing tables on startup. Turn OFF in production where DBAs apply
# src/reconx/metrics/migrations/*.sql themselves.
RESULT_AUTO_CREATE_SCHEMA=true
# Optional: override the SQLAlchemy URL used by the control plane
#RESULT_SQLALCHEMY_URL=postgresql+psycopg://reconx:reconx@localhost:5432/reconx_results

# ----------------------------------------------------------------- Spark
SPARK_MASTER=local[*]                # local[*] | spark://host:7077 | k8s://https://...
SPARK_SUBMIT_MODE=inprocess          # inprocess | spark-submit | kubernetes
#SPARK_HOME=/opt/spark
SPARK_NAMESPACE=reconx
SPARK_IMAGE=reconx/spark:1.0.0
SPARK_SERVICE_ACCOUNT=reconx-spark
SPARK_DRIVER_CORES=1
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_INSTANCES=2
SPARK_DYNAMIC_ALLOCATION=false
SPARK_SHUFFLE_PARTITIONS=200
SPARK_ADAPTIVE_ENABLED=true
# JDBC drivers and connectors on the Spark classpath (comma separated)
#SPARK_EXTRA_JARS=/opt/reconx/jars/postgresql-42.7.4.jar
#SPARK_EXTRA_PACKAGES=org.apache.hadoop:hadoop-aws:3.3.4

# ------------------------------------------------------------- scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=30
SCHEDULER_LOCK_TTL_SECONDS=120
SCHEDULER_MAX_CONCURRENT_RUNS=10
#RECONX_NODE_ID=                      # defaults to the hostname / pod name

# ------------------------------------------------------------------ SMTP
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USE_SSL=false
#SMTP_USERNAME=
#SMTP_PASSWORD=                       # secret
SMTP_FROM_ADDRESS=reconx@example.com
SMTP_FROM_NAME=ReconX Platform

# -------------------------------------------------------------- security
# Generate with: reconx-admin gen-key
RECONX_SECURITY_ENCRYPTION_KEY=       # secret - REQUIRED outside development
RECONX_SECURITY_JWT_SECRET=change-me-in-production   # secret - 32+ random bytes
RECONX_SECURITY_JWT_EXPIRY_MINUTES=480
RECONX_SECURITY_AUTH_ENABLED=true
RECONX_SECURITY_SECRETS_BACKEND=auto  # auto | env | file | encrypted
RECONX_SECURITY_SECRETS_FILE_DIR=/var/run/secrets/reconx
RECONX_SECURITY_BOOTSTRAP_ADMIN_USERNAME=admin
# Leave blank to have a password generated and printed once in the API log.
RECONX_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------- API / UI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=*                    # restrict to your UI origin in production
API_BASE_URL=http://localhost:8501
RECONX_API_URL=http://localhost:8000  # used by the Streamlit UI

# -------------------------------------------------------------- advisor
# The advisor is deterministic by default and needs no external service.
# Enable narrative mode to have the same evidence phrased by Claude.
ADVISOR_LLM_ENABLED=false
#ANTHROPIC_API_KEY=
#ADVISOR_LLM_MODEL=claude-sonnet-5
