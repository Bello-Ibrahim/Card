# Public base URL of the deployed site. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="https://www.gracewellconsulting.com"

# Where contact form submissions are delivered.
# Set this to an HTTPS endpoint that accepts a JSON POST (CRM webhook, Zapier/Make hook,
# a serverless function that emails your inbox, etc.).
# If it is left unset, submissions are validated and logged server-side only — nobody receives them.
CONTACT_WEBHOOK_URL=""

# Optional shared secret sent as `x-gracewell-signature` with each forwarded submission.
CONTACT_WEBHOOK_SECRET=""
