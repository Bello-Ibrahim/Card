{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CourseForge course brief",
  "type": "object",
  "required": [
    "course_title",
    "level",
    "target_learner",
    "duration",
    "learning_outcome",
    "languages",
    "brand",
    "presenter",
    "budget_limit_usd",
    "mode"
  ],
  "properties": {
    "course_title": {
      "type": "string",
      "minLength": 3
    },
    "course_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{2,}$",
      "description": "Catalog ID, e.g. 'AI-01'. Used as the slug prefix."
    },
    "track": {
      "type": "string"
    },
    "level": {
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ]
    },
    "target_learner": {
      "type": "string"
    },
    "duration": {
      "type": "string",
      "description": "Total course length, e.g. '90 minutes' or '4 weeks'."
    },
    "target_lessons": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "lesson_length_min": {
      "type": "number",
      "minimum": 3,
      "maximum": 6,
      "description": "Target video length per lesson; the script is ~140 words per minute."
    },
    "learning_outcome": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools_free_first": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tools that examples and exercises should use, free options first."
    },
    "capstone_project": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "minItems": 1,
      "contains": {
        "const": "en"
      }
    },
    "brand": {
      "type": "object",
      "required": [
        "colors",
        "fonts",
        "tone"
      ],
      "properties": {
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "minItems": 1
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "tone": {
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        }
      }
    },
    "presenter": {
      "type": "object",
      "required": [
        "avatar_id",
        "voice_id"
      ],
      "properties": {
        "avatar_id": {
          "type": "string"
        },
        "voice_id": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      },
      "description": "avatar_id and voice_id may be empty until the HeyGen Batch Pack (Stage 4); Stages 1-3 can run without them."
    },
    "budget_limit_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "mode": {
      "enum": [
        "auto",
        "manual"
      ]
    },
    "technical": {
      "type": "boolean",
      "default": false,
      "description": "Enables Screen Demo Packs (OBS)."
    },
    "export_vertical": {
      "type": "boolean",
      "default": false,
      "description": "Also export 9:16."
    },
    "burn_translated_captions": {
      "type": "boolean",
      "default": false
    }
  }
}
