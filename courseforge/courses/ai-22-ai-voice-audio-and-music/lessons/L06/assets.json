      "status": "PENDING_UPLOAD",
      "steps": [
        "Open Audacity and drag the recording into the window",
        "Save a copy of the original file",
        "Play the recording with headphones",
        "Zoom in on the first two seconds: a thin band of fan noise before the voice starts"
      ]
    },
    {
      "scene": 9,
      "start": 141.3,
      "end": 161.4,
      "visual_type": "screen",
      "file": "/incoming/ai-22-ai-voice-audio-and-music_L06_screen_2.mp4",
      "status": "PENDING_UPLOAD",
      "steps": [
        "Select the two seconds of fan noise",
        "Open Effect > Noise Removal and Repair > Noise Reduction and click Get Noise Profile",
        "Select the whole track with Ctrl+A, or Cmd+A on a Mac",
        "Open Noise Reduction again, keep gentle settings and click Preview",
        "Click OK and play a few seconds: the hum is almost gone"
      ]
    },
    {
      "scene": 10,
      "start": 161.4,
      "end": 178.1,
      "visual_type": "screen",
      "file": "/incoming/ai-22-ai-voice-audio-and-music_L06_screen_3.mp4",
      "status": "PENDING_UPLOAD",
      "steps": [
        "Select the false start at the beginning and press Delete",
        "Select the whole track and open Truncate Silence",
        "Set long pauses to be shortened to under one second, then click Apply",
        "Show the two gaps in the waveform are now shorter"
      ]
    },
    {
      "scene": 11,
      "start": 178.1,
      "end": 196.5,
      "visual_type": "screen",
      "file": "/incoming/ai-22-ai-voice-audio-and-music_L06_screen_4.mp4",
      "status": "PENDING_UPLOAD",
      "steps": [
        "Select the whole track and apply Compressor with default settings",
        "Apply Normalize so the peak stays below 0 dB",
        "Show the waveform: quiet lines are now closer in size to loud ones"
      ]
    },
    {
      "scene": 12,
      "start": 196.5,
      "end": 213.6,
      "visual_type": "screen",
      "file": "/incoming/ai-22-ai-voice-audio-and-music_L06_screen_5.mp4",
      "status": "PENDING_UPLOAD",
      "steps": [
        "Open Filter Curve EQ and lower the high frequencies slightly",
        "Preview, then click Apply",
        "Play ten seconds of the original copy, then the same ten seconds of the cleaned track",
        "Choose File > Export Audio and export as WAV"
      ]
